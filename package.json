{
  "name": "asignapp-inventario",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ASIGNAPP — Inventario de bodega para Constructora HYCE",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/browser": "^0.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.0"
  }
}
